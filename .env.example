# Copy to .env and fill in. Never commit .env.
# Long random string, different for every environment.
PAYLOAD_SECRET=
# Local: postgres://postgres:postgres@127.0.0.1:5432/portfolio (docker compose). Vercel: set by the Neon integration.
POSTGRES_URL=
# Set by connecting Vercel Blob (from T6).
BLOB_READ_WRITE_TOKEN=
# Public base URL of this environment, e.g. http://localhost:3000
NEXT_PUBLIC_SERVER_URL=
# Long random string; turns on draft mode via /next/preview for logged-in editors. Different per environment.
PREVIEW_SECRET=
# Resend API key (P3): sends the inquiry alert and Payload's emails. Empty = emails are only logged to the console.
RESEND_API_KEY=
# Optional From address. Empty = Resend's test sender (onboarding@resend.dev) until the domain is verified in P7.
EMAIL_FROM_ADDRESS=
